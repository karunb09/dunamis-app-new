# ----------------------------------------------------------------------------
# Dunamis LMS backend — environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# ----------------------------------------------------------------------------

# --- Core (required; server refuses to start without these) ---
MONGODB_URL=mongodb+srv://user:pass@cluster/db
PORT=3003

# JWT signing secret. MUST be a strong random value (>= 32 chars).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this logs every user out once; do it deliberately.
# Example freshly generated value (DO NOT reuse this one in production):
JWT_SECRET=5ebFJUHX_H35Fy1iwZv5FLgfOHH80wtt3BlvAdyoRoXS_xRGTu2DqgldVcd_nvMR

# Access-token lifetime in minutes. No refresh token, so this is effectively the
# session length before a user must log in again. Default 15.
JWT_ACCESS_TTL_MINUTES=15

# Set to "production" on prod. In production the server will refuse to boot
# with a weak/placeholder JWT_SECRET.
NODE_ENV=development

# --- Uploads ---
# Max upload size in MB (default 300 if unset). Lower once you confirm the
# largest legitimate file size, e.g. MAX_UPLOAD_MB=50
MAX_UPLOAD_MB=50

# --- CORS (comma-separated extra origins, optional) ---
CORS_ALLOWED_ORIGINS=

# --- Mail ---
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cashfree (payments) ---
BASE_URL=
CASHFREE_ENV=
CASHFREE_API_VERSION=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_RETURN_URL=
CASHFREE_NOTIFY_URL=
